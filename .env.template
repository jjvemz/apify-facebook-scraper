# =============================================================================
# APIFY CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and fill in your actual values

# Your Apify API token (REQUIRED)
# Get this from: https://console.apify.com/account/integrations
# Example: apify_api_1234567890abcdefghijklmnopqrstuvwxyz
APIFY_API_TOKEN=your_apify_api_token_here

# Actor IDs for scraping (OPTIONAL - uses defaults if not specified)
# Default reel scraper actor
REELS_ACTOR_ID=apify/facebook-reels-scraper

# Default comments scraper actor  
COMMENTS_ACTOR_ID=apify/facebook-comments-scraper

# Default followers & following scraper actor
FOLLOWERS_ACTOR_ID=apify/facebook-followers-following-scraper

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Rename this file from '.env.template' to '.env'
# 2. Replace 'your_apify_api_token_here' with your actual Apify API token
# 3. Optionally customize the actor IDs if you want to use different scrapers
# 4. Save the file
# 5. Run the scraper: python scraper.py --help

# =============================================================================
# EXAMPLE CONFIGURATION
# =============================================================================
# APIFY_API_TOKEN=apify_api_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijk123
# REELS_ACTOR_ID=apify/facebook-reels-scraper
# COMMENTS_ACTOR_ID=apify/facebook-comments-scraper
# FOLLOWERS_ACTOR_ID=apify/facebook-followers-following-scraper